[Unit]
Description=APIx APScheduler scrape process
After=network.target postgresql.service
[Service]
User=apix
WorkingDirectory=/opt/apix
Environment=DATABASE_URL=postgresql+psycopg://apix:secret@localhost:5432/apix
Environment=SCRAPE_CRON=0 2 * * *
ExecStart=/opt/apix/venv/bin/python -m scraper.scheduler
Restart=always
[Install]
WantedBy=multi-user.target
