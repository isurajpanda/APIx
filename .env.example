# APIx runtime environment — sourced automatically by backend (python-dotenv)
# and usable in shells via: set -a; source .env; set +a
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apix
APIX_API_KEY=dev-key
MEMCACHED_SERVERS=127.0.0.1:11211
APIX_CACHE_TTL=300
SCRAPE_CRON="0 2 * * *"
PROXY_REFRESH_HOURS=3
APIX_SCRAPER_MOCK=true
# Playwright client override: set to "chrome" on hosts where bundled Chromium
# gets TLS-fingerprinted (Air India hangs/resets it; real Chrome loads fine).
APIX_PLAYWRIGHT_CHANNEL=
# Official provider APIs (compliant path where scraping is disallowed/gated).
# Ixigo: parked for scraping — supply partnership credentials to enable.
IXIGO_API_KEY=
IXIGO_API_URL=
IXIGO_AFFILIATE_ID=
# Affiliate/NDC partnerships for bot-walled or CAPTCHA-gated providers.
MMT_API_KEY=
MMT_API_URL=
GOIBIBO_API_KEY=
GOIBIBO_API_URL=
AIX_API_KEY=
AIX_API_URL=
YATRA_API_KEY=
YATRA_API_URL=
