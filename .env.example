# APIx runtime environment — sourced automatically by backend (python-dotenv)
# and usable in shells via: set -a; source .env; set +a
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apix
APIX_API_KEY=dev-key
MEMCACHED_SERVERS=127.0.0.1:11211
APIX_CACHE_TTL=300
SCRAPE_CRON=0 2 * * *
PROXY_REFRESH_HOURS=3
APIX_SCRAPER_MOCK=true
